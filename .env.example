# Copy to .env.local. Never put these values in VITE_* variables.
# Keep disabled until the provider, data scope and call costs are authorized.
MODEL_CALLS_ENABLED=false
MODEL_ENDPOINT=
MODEL_NAME=
MODEL_API_KEY=
# The adapter expects a chat-completions compatible JSON endpoint.
# Other provider formats require a dedicated adapter; compatibility is unverified.

# Optional, verified only for Bailian Beijing Qwen models; blank keeps generic mode.
MODEL_PROFILE=
# MODEL_PROFILE=qwen-json-nonthinking
